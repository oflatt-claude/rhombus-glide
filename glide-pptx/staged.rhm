#lang rhombus/and_meta
// Showing a slide the way a talk shows one: numbered, revealed, and arrived at.
//
// This is the `staged_slide` from the 2026 ICFP talk, brought here so that a
// converted deck and a hand-written one are shown by the same code. A generated
// program is meant to become a hand-written one, and a talk that has been half
// rewritten should not change how it plays.
//
// What it adds to slideshow's `slide`:
//
//   * `set_slide_numbers`, which draws the number `--skip` wants in the corner
//     -- off by default, since it is ink the deck did not ask for, and the one
//     thing you want when rehearsing from the middle;
//   * `set_start_from`, so the numbering stays honest when slides are skipped;
//   * `set_reveal`, which fades each slide up from blank -- off by default,
//     because a deck cuts;
//   * `~transition:`, how the next slide arrives -- `#'up`, `#'down`, `#'left`
//     and `#'right` pan the old page off that edge, and `#'none` cuts to it,
//     which is the default and what a deck does;
//   * `dead_beats`, which reads the frames back and says which advances change
//     nothing, because a press of the clicker that does no work is invisible in
//     the source and obvious from the audience;
//   * a held last frame on any slide that animates, so the closing epoch is not
//     spent on the press that moves on -- see where `held` is computed below.
//
// Two changes from the talk's copy, both because this one is a library: the
// slide assembler is installed on first use rather than on import, and a slide
// may arrive as a pict handle, which is what `slide_canvas` hands back.
import:
  slideshow open
  draw
  lib("slideshow/main.rkt") as ss

export:
  staged_slide
  do_staged_slide           // the function behind the macro, for a show that loops
  dead_beats                // advances that change nothing; see below
  set_start_from
  set_transitions
  set_slide_numbers
  set_pan_extent
  set_debug_epochs
  set_reveal
  set_reveal_extent

def _slide_no = Array(0)
def _start_from = Array(1)
def _current = Array(0)   // logical number of the slide currently being assembled
// How the next slide arrives when a slide does not say. A cut, which is what a
// deck does: PowerPoint advances to the next slide and there it is. A talk that
// wants the pages to move says so -- `set_transitions(#true)` for the downward
// pan, or `set_transitions(#'left)` for a particular direction.
def _default_transition = Array(#'none)
def _emitted = Array(#false)   // has any slide been emitted yet?

// The number to start counting from, which is what was passed to `--skip` plus
// one: skipping does not renumber the slides that are left.
fun set_start_from(n :: Int): _start_from[0] := n

// The transition every slide gets unless it names its own: #f or `#'none` for
// a cut, #t for the downward pan, or a direction. A slide's own `~transition:`
// always wins over this.
fun set_transitions(on):
  _default_transition[0] := (if on is_a Symbol
                             | on
                             | (if on | #'down | #'none))

// Print each slide's epoch count (= advances it costs) as it is built.
def _debug_epochs = Array(#false)
fun set_debug_epochs(on): _debug_epochs[0] := on

// A slide arrives as a `Pict` from hand-written code and as a pict handle from
// `slide_canvas`.
fun as_pict(s) :: Pict:
  if s is_a Pict | s | Pict.from_handle(s)

// Does this pict draw anything at all? Used by the debug report to spot slides
// whose first frame is empty, where the reveal fade shows only the title.
fun has_ink(p :: Pict) :: Boolean:
  def w = math.max(1, math.exact(math.ceiling(p.width)))
  def h = math.max(1, math.exact(math.ceiling(p.height)))
  def bm = draw.Bitmap([w, h])
  p.draw(bm.make_dc())
  def px = bm.argb_pixels()
  recur go(i = 0):
    cond
    | i >= px.length(): #false
    | px[i] > 0: #true
    | ~else: go(i + 4)

// The pixels a slide comes to rest on at the end of epoch `i`.
fun frame_pixels(p :: Pict, i :: Int, n :: Real) :: Bytes:
  def q = p.snapshot(i, n)
  def w = math.max(1, math.exact(math.ceiling(q.width)))
  def h = math.max(1, math.exact(math.ceiling(q.height)))
  def bm = draw.Bitmap([w, h])
  q.draw(bm.make_dc())
  bm.argb_pixels()

fun rest_pixels(p :: Pict, i :: Int) :: Bytes: frame_pixels(p, i, 1.0)

// A quarter in, not half way: `small_steps` wiggles its target through a whole
// sine cycle, so a wiggle epoch is back at rest at its own midpoint and only a
// quarter-way sample tells it apart from an epoch that never moves.
fun early_pixels(p :: Pict, i :: Int) :: Bytes: frame_pixels(p, i, 0.25)

// Two frames that look the same on screen. Byte equality is too strict: a pict
// that reaches the screen through an `alpha(1.0)` layer, or through the wrapper
// `sustain` puts around it, is composited rather than drawn straight, and channel
// values all over the frame come out a shade off.
//
// So the two thresholds do different jobs. The per-pixel one absorbs that
// everywhere-but-tiny difference; the budget stays small, because what it has to
// notice is a *small* thing that really moved -- a short redex rotating a few
// degrees under `wiggle` touches only a few hundred pixels, and a budget scaled to
// the frame would swallow it.
fun looks_same(a :: Bytes, b :: Bytes) :: Boolean:
  a.length() == b.length()
    && block:
         def n = a.length()
         recur go(i = 0, bad = 0):
           cond
           | i >= n: #true
           | bad > 24: #false
           | ~else: go(i + 32, if math.abs(a[i] - b[i]) > 8 | bad + 1 | bad)

// Advances that change nothing: an epoch is dead when it comes to rest looking
// like the epoch before it AND never moves on the way -- so one press of the
// clicker does no work at all. Epoch counts alone can't tell you which press is
// the dead one, and reading the frames back is the only way to be sure: a beat
// can differ in structure and still look identical.
//
// The early sample is what keeps `small_steps` honest here: every step it takes
// is a wiggle epoch followed by a morph epoch, and a wiggle ends exactly where it
// began -- so comparing rests alone would flag every step in the talk.
//
// A slide that ends in `.sustain()` always reports its last epoch, since that is
// what sustaining is: one more advance holding the same frame.
fun dead_beats(p) :: List:
  def q :~ Pict = as_pict(p)
  recur go(i = 1, prev :~ Bytes = rest_pixels(q, 0), acc :~ List = []):
    if i >= q.duration
    | acc
    | def cur = rest_pixels(q, i)
      def still = looks_same(cur, prev) && looks_same(early_pixels(q, i), prev)
      go(i + 1, cur, if still | acc ++ [i] | acc)

fun force(make): if make is_a Function | make() | make

// Fading each slide up from blank: one epoch drawing a snapshot of the slide's
// own first frame at rising alpha, then the content. It costs an advance per
// slide, and -- because that first frame is drawn over nothing -- it means
// leaving a slide blanks the screen before the next one appears. That is a
// choice a talk makes, not the way a deck behaves, so it is off unless asked
// for: a converted deck cuts from slide to slide the way it did in PowerPoint.
def _reveal = Array(#false)
def _reveal_extent = Array(0.4)
fun set_reveal(on): _reveal[0] := on
fun set_reveal_extent(e :: Real): _reveal_extent[0] := e

fun reveal_first(p :: Pict) :: Pict:
  def first = p.snapshot(0, 0)
  def fade = animate(~extent: _reveal_extent[0], fun (n): first.alpha(n))
  // A slide whose own first beat is a still repeats the picture the fade just
  // landed on, so that press shows nothing. Splice it away instead of spending a
  // press on it. A slide that starts by animating keeps its own beat.
  if p.epoch_extent(0) == 0
  | switch(fade, p, ~join: #'splice)
  | switch(fade, p)

// Pan from the previous slide to the next: the old page slides off one edge as
// the new one comes in from the other.
def _pan_extent = Array(0.5)
fun set_pan_extent(e :: Real): _pan_extent[0] := e

fun pan_offset(dir, w :: Real, h :: Real):
  match dir
  | #'right: values(w, 0.0)
  | #'left: values(-w, 0.0)
  | #'down: values(0.0, h)
  | #'up: values(0.0, -h)

fun pan_transition(dir):
  fun (prev :: StaticPict, next :: Pict, data :: Map):
    def page = next.snapshot(0, 0)
    def w = math.max(prev.width, page.width)
    def h = math.max(prev.height, page.height)
    def (dx, dy) = pan_offset(dir, w, h)
    def frame = blank(~width: w, ~height: h)
    def lead:
      animate(~extent: _pan_extent[0],
              fun (n):
                overlay(~horiz: #'left, ~vert: #'top,
                        frame,
                        prev.translate(-n * dx, -n * dy),
                        page.translate((1.0 - n) * dx, (1.0 - n) * dy))
                  .refocus(frame))
    values(switch(lead, next).time_pad(~before: -1), #true)

// The slide's logical number -- the one `--skip` wants -- drawn small in the
// bottom-right. Off unless asked for: it is ink on a deck that did not ask for
// it, and a deck is meant to look the way it looked. Rehearsing is what it is
// for, and rehearsing is when you turn it on.
def _numbers = Array(#false)
def _installed = Array(#false)
fun set_slide_numbers(on): _numbers[0] := on

fun numbered_asm(default_asm):
  fun (s, v_sep, p):
    def base = Pict.from_handle(default_asm(s, v_sep, p))
    cond
    | !_numbers[0]: base.handle
    | ~else:
        def tag = bold("" +& _current[0]).colorize("black")
        overlay(~horiz: #'right, ~vert: #'bottom,
                base, tag.pad(~right: 6, ~bottom: 2)).snapshot().handle

// On first use rather than on import: this is a library, and importing it to
// call `dead_beats` on a pict should not change how a program's own slides are
// assembled.
fun install_assembler():
  when !_installed[0]
  | _installed[0] := #true
    def default_asm = ss.#{current-slide-assembler}()
    ss.#{current-slide-assembler}(numbered_asm(default_asm))
    ss.#{set-page-numbers-visible!}(#false)

// `~transition` names where the next slide comes from: `#'down` (the default)
// means the old page leaves upwards and this one follows it in.
fun do_staged_slide(make, ~title: ttl = #false, ~transition: tr = #false,
                    ~reveal: rv = #true, ~& kws):
  install_assembler()
  _slide_no[0] := _slide_no[0] + 1
  when _slide_no[0] >= _start_from[0]
  | _current[0] := _slide_no[0]
    def content = force(make)
    // What this slide asked for, or what the talk asked for. Skipped on the
    // first slide, because a transition needs a previous page, and on `#'none`,
    // which is a cut -- and suits a predecessor that animates itself out.
    def arrival = tr || _default_transition[0]
    when _emitted[0] && arrival != #'none
    | slide_transition(pan_transition(arrival))
    _emitted[0] := #true
    def shown:
      if _reveal[0] && rv && !(content is_a List)
      | reveal_first(as_pict(content))
      | content
    when _debug_epochs[0]
    | block:
        // A slide given as a list of picts is slideshow's own layout, not one
        // page, and there is nothing to measure epochs on.
        def measured = (if content is_a List | #false | as_pict(content))
        def shown_dead = (if shown is_a Pict | dead_beats(shown) | [])
        println("slide " +& _current[0] +& " [" +& (ttl || "-") +& "] epochs: "
                  +& (if measured | (measured :~ Pict).duration | "n/a")
                  +& (if shown is_a Pict | " -> " +& (shown :~ Pict).duration | "")
                  +& (if measured
                      | block:
                          def c :~ Pict = measured
                          // on what is *shown*, too: the reveal fades in the
                          // first frame, so a static first epoch repeats it --
                          // a dead press that never shows up when only
                          // `content` is measured
                          def e0 = !has_ink(c.snapshot(0, 0))
                          def e0_end = !has_ink(c.snapshot(0, 1.0))
                          def dead = dead_beats(c)
                          (if e0 | "  EMPTY-first-frame" | "")
                            +& (if e0_end | "  EMPTY-epoch0" | "")
                            +& (if dead == [] | "" | "  DEAD-BEATS " +& dead)
                            +& (if shown_dead == [] | "" | "  SHOWN-DEAD " +& shown_dead)
                      | ""))
    // A slide's final epoch plays as the *outgoing* transition -- the press
    // that runs it is the same press that moves on -- so whatever that epoch
    // adds is never seen at rest. Sustaining gives the transition a duplicate
    // frame to consume instead, which is why the extra press is not wasted even
    // though `dead_beats` reports it as one. A slide that does not animate has
    // no closing frame to lose, so it is left alone rather than spending a
    // press on a frame nobody needs.
    def held:
      if shown is_a Pict && (shown :~ Pict).duration > 1
      | (shown :~ Pict).sustain()
      | shown
    if held is_a List
    | slide(& held, ~title: ttl, ~& kws)
    | slide(held, ~title: ttl, ~& kws)

expr.macro 'staged_slide:
              $(group_option_sequence
                | '~title: $(ttl :: Block)':
                    default ttl = ': #false'
                | '~transition: $(tr :: Block)':
                    default tr = ': #false'
                | '~reveal: $(rv :: Block)':
                    default rv = ': #true')
              $body
              ... ~nonempty':
  'do_staged_slide(fun (): $body; ..., ~title $ttl, ~transition $tr, ~reveal $rv)'
